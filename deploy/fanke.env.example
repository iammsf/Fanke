# fanke 运行时配置示例
# 实际文件由安装向导或 deploy/install.sh 生成:/opt/fanke/state/fanke.env(权限 0600)
# 格式为每行 KEY=VALUE,支持 # 注释;修改后执行 systemctl restart fanke-api 生效。

# ---------- 必填 ----------
# PostgreSQL 连接串(密码含特殊字符时需 URL 编码)
DATABASE_URL=postgres://fanke:change-me@127.0.0.1:5432/fanke?sslmode=disable
# JWT 签名密钥:至少 32 位随机值(可用 openssl rand -hex 32 生成),严禁在生产环境使用示例值 change-me
JWT_SECRET=change-me
# 找回密钥:至少 16 位随机值(可用 openssl rand -hex 16 生成),数据库断连时在网页向导重配需要出示它,严禁在生产环境使用示例值 change-me
RECOVERY_KEY=change-me

# ---------- 服务 ----------
# 生产建议只监听回环地址,由 nginx 反代对外
ADDR=127.0.0.1:8081
# 站点对外根 URL(用于生成 sitemap.xml 等,防止 Host 请求头投毒;末尾不要加 /)
# 建议生产环境始终显式配置:
# SITE_URL=https://blog.example.com

# ---------- 存储 ----------
# 本地媒体卷目录(原图/派生图落盘位置)
MEDIA_LOCAL_DIR=/opt/fanke/media
# 本地媒体对外 URL 前缀
MEDIA_BASE_URL=/uploads
# 运行时上传的主题目录
THEMES_DIR=/opt/fanke/themes
# 服务端插件目录(不填时默认取 THEMES_DIR 同级的 extensions)
EXTENSIONS_DIR=/opt/fanke/extensions
# 缩略图(WebP)磁盘缓存目录,可随时清空,不影响数据
THUMB_DIR=/var/cache/fanke-thumbs
# 允许服务端代为抓取并缩图的外部主机(逗号分隔,防 SSRF;留空 = 一律拒绝)
THUMB_ALLOW_HOSTS=

# ---------- 内网服务白名单(SSRF 防护) ----------
# 默认禁止服务端向回环地址(127.0.0.1/localhost)及内网私有网段发起请求,防止 SSRF。
# 若需对接同机或内网自建的 Ollama / OpenAI 兼容 AI 服务,按逗号分隔放行主机名、IP 或 CIDR 网段:
# 例如: ALLOW_PRIVATE_AI_HOSTS=127.0.0.1,localhost,192.168.0.0/16
ALLOW_PRIVATE_AI_HOSTS=
# 若需对接同机或内网自建的 MinIO / S3 兼容对象存储,按逗号分隔放行主机名、IP 或 CIDR 网段:
# 例如: ALLOW_PRIVATE_S3_HOSTS=127.0.0.1,localhost,192.168.0.0/16
ALLOW_PRIVATE_S3_HOSTS=

# ---------- 可选 ----------
# Redis(用于多实例共享限流计数,单机可不配)
# REDIS_URL=redis://127.0.0.1:6379/0

# Cookie 是否禁用 Secure 标记。默认 false(仅 HTTPS 可用);
# 纯 HTTP 部署必须设为 true,否则浏览器不会保存登录 Cookie;启用 HTTPS 后改回 false。
# INSECURE_COOKIE=false

# 更新清单地址。默认走 GitHub raw(无需配置):
# https://raw.githubusercontent.com/iammsf/fanke/main/updates.json
# 可选渠道(内容格式一致,按网络情况自己切换):
#   GitHub raw   https://raw.githubusercontent.com/iammsf/fanke/main/updates.json(默认)
#   jsDelivr     https://cdn.jsdelivr.net/gh/iammsf/fanke@main/updates.json
#   自建镜像     自己的 URL
# UPDATE_MANIFEST_URL=https://cdn.jsdelivr.net/gh/iammsf/fanke@main/updates.json

# 下载清单/升级包时使用的 HTTP 代理(留空直连)。服务器无法直连 GitHub 时填,例如:
# UPDATE_PROXY=http://127.0.0.1:10808

# 在线升级目标目录。留空时自动推断:安装目录取可执行文件的上上级,
# 前端目录优先取 THEMES_DIR 所在站点的 index,否则用 APP_DIR/web。
# APP_DIR=/opt/fanke
# WEB_ROOT=/opt/1panel/www/sites/example.com/index

# ---------- 自动化创建首个管理员(仅在用户表为空时生效) ----------
# 不填则首次打开站点进入「创建管理员」向导
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=change-me-please
